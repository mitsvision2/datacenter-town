# Copy this file to utils.py and fill in your API keys.
# utils.py is gitignored.

# --- LLM provider ---
# openai | anthropic | openai_compatible
llm_provider = "openai"
chat_model = "gpt-4o"
# Optional override for the legacy GPT4_* helpers
gpt4_model = "gpt-4o"

# Embeddings (OpenAI or openai_compatible recommended)
embedding_provider = "openai"
embedding_model = "text-embedding-3-small"

openai_api_key = "<Your OpenAI API key>"
anthropic_api_key = ""
# Together / OpenRouter / local OpenAI-compatible endpoint
openai_compatible_base_url = ""
openai_compatible_api_key = ""

key_owner = "<Your Name>"

# --- Paths (leave as-is for standard checkout) ---
maze_assets_loc = "../../environment/frontend_server/static_dirs/assets"
env_matrix = f"{maze_assets_loc}/the_ville/matrix"
env_visuals = f"{maze_assets_loc}/the_ville/visuals"

fs_storage = "../../environment/frontend_server/storage"
fs_temp_storage = "../../environment/frontend_server/temp_storage"

collision_block_id = "32125"

# Verbose LLM / cognitive debug prints
debug = True

# Runtime logging (sim_logging.py)
log_level = "INFO"       # DEBUG | INFO | WARNING | ERROR
log_to_file = True
log_dir = "logs"         # written under reverie/backend_server/logs by default

# Experiment logging
experiment_scenario_id = "datacenter_proposal_v1"
snapshot_every_n_steps = 50
